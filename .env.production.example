# Production environment for docker-compose.
# On the server: copy to .env (next to docker-compose.yml) and fill in.
# Create/edit it on the server itself (nano) - a file copied from Windows may
# carry CRLF line endings that silently corrupt values.
# Quote any value that contains spaces or special characters.

# Public hostname, no scheme (example.ru). A bare server IP also works:
# the stack then keeps a self-signed certificate (browser warning, no Let's Encrypt).
DOMAIN=example.ru
# Email for Let's Encrypt expiry notices. Required unless DOMAIN is an IP.
CERTBOT_EMAIL=you@example.com

# Postgres (runs inside docker, not exposed publicly).
# Letters/digits only in the password - it is embedded into DATABASE_URL.
POSTGRES_USER=prepai
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=prepai

# JWT - each secret MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# DeepSeek (the only AI provider). The key stays on the backend.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mail - OPTIONAL. Priority: Resend API > Brevo API > SMTP > Ethereal test
# inbox (the latter delivers nothing; preview URLs go to backend logs).
# Resend/Brevo send over HTTPS:443 - use them when the hoster firewalls
# outbound SMTP ports. MAIL_FROM must be a verified sender address.
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InterviewPrep <no-reply@example.ru>"
