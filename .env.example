# ----------------------------------------------------------------------
# PrepAI — environment template. Copy to .env and fill in real values.
# ----------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=prepai
POSTGRES_PASSWORD=change_me_please_use_strong_password
POSTGRES_DB=prepai

# Database connection string used by the backend (Prisma).
# For Docker Compose: host "postgres". For local dev: host "localhost".
DATABASE_URL=postgresql://prepai:change_me_please_use_strong_password@localhost:5432/prepai

# JWT secrets — each MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_random_string_at_least_32_chars_long_aaaaa
JWT_REFRESH_SECRET=replace_with_another_random_string_at_least_32_chars_bbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# AI Provider: mock | ollama | gemini
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini settings (if AI_PROVIDER=gemini). Keep the key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Runtime
NODE_ENV=development
PORT=3000
