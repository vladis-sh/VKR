# Database
DATABASE_URL="postgresql://prepai:change_me_please_use_strong_password@localhost:5432/prepai"

# JWT — each secret MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET="replace_with_random_string_at_least_32_chars_long_aaaaa"
JWT_REFRESH_SECRET="replace_with_another_random_string_at_least_32_chars_bbb"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# DeepSeek (the only AI provider). OpenAI-compatible API.
# Get a key at https://platform.deepseek.com. The key MUST stay on the backend only.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
