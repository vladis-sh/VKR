# Database
DATABASE_URL="postgresql://prepai:change_me_please_use_strong_password@localhost:5432/prepai"

# JWT — each secret MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET="replace_with_random_string_at_least_32_chars_long_aaaaa"
JWT_REFRESH_SECRET="replace_with_another_random_string_at_least_32_chars_bbb"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# AI Provider: gemini | ollama | mock
AI_PROVIDER=mock

# Ollama settings (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Gemini settings (if AI_PROVIDER=gemini). The key MUST stay on the backend only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
